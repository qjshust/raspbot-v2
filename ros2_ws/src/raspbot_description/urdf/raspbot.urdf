<?xml version="1.0"?>
<!-- ============================================================================
  RASPBOT-V2 URDF —— 全车静态 TF / 外参的唯一来源

  维护：WP-E（CONTRACTS.md v1.2 §1/§3：raspbot_description/** 由 E 独占维护）
  坐标约定：ROS REP-103（x 前 / y 左 / z 上），长度米、角度弧度（右手定则）。
  本文件不使用 xacro：外参直接写数值，改动时同步本表与对应 joint 的 <origin>，
  并更新 README.md 的「外参标定表」。

  ┌────────────── 外参标定表（改外参 = 改本表 + 对应 joint 的 <origin>）──────────────┐
  │ joint                 | child          | x (m)   | y | z (m)   | rpy     | 来源/状态                          │
  │ base_footprint_joint  | base_footprint |  0.000  | 0 |  0.000  | 0 0 0   | base_link 即地面轴距中点，投影重合      │
  │ laser_joint           | laser          | +0.107  | 0 | +0.034  | 0 0 0   | J-04 契约值（雷达在车头前/上方），       │
  │                       |                |         |   |         |         | 待 CAR-C05 卷尺复核                  │
  │ imu_joint             | imu_link       |  0.000  | 0 | +0.080  | 0 0 0   | 设计 §5.5.5：IMU 约在甲板上方 40 mm、   │
  │                       |                |         |   |         |         | 接近车体几何中心，初值待卷尺复核        │
  │ camera_joint          | camera_link    | +0.077  | 0 | +0.095  | 0 0 0   | 初值占位（云台/甲板前缘），             │
  │                       |                |         |   |         |         | pitch=0.0 待 CAR-C05/C06 标定         │
  │ ultrasonic_joint      | ultrasonic     | +0.070  | 0 | +0.030  | 0 0 0   | 车头超声，初值占位                    │
  └────────────────────────────────────────────────────────────────────────────────────┘

  规则（CONTRACTS §3）：
  - 上表所有变换只能由 robot_state_publisher（读本 URDF）发布；
  - 禁止在其他节点重复发布、禁止 static_transform_publisher 发布动态变换；
  - frame 命名固定：base_link / odom / map / laser / imu_link / camera_link / ultrasonic。

  odom→base_link 由 ekf_node（raspbot_fusion，WP-E）发布，不在本文件内。
============================================================================ -->
<robot name="raspbot">

  <!-- ================= base_link：车体（轴距中点、地面高度） ================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.175 0.160 0.050"/>
      </geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <material name="chassis_grey">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.175 0.160 0.050"/>
      </geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.00234" ixy="0.0" ixz="0.0"
               iyy="0.00276" iyz="0.0"
               izz="0.00469"/>
    </inertial>
  </link>

  <!-- ================= base_footprint：地面投影（与 base_link 原点重合） ================= -->
  <link name="base_footprint">
    <visual>
      <geometry>
        <box size="0.030 0.030 0.004"/>
      </geometry>
      <origin xyz="0 0 -0.002" rpy="0 0 0"/>
      <material name="footprint_grey">
        <color rgba="0.6 0.6 0.6 0.5"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0.0" ixz="0.0"
               iyy="1e-8" iyz="0.0"
               izz="1e-8"/>
    </inertial>
  </link>

  <!-- ================= laser：激光雷达（RPLIDAR C1，车头前 +0.107 m / 上 +0.034 m） ================= -->
  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.060"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="laser_red">
        <color rgba="0.9 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000161" ixy="0.0" ixz="0.0"
               iyy="0.000161" iyz="0.0"
               izz="0.000202"/>
    </inertial>
  </link>

  <!-- ================= imu_link：HWT101（约甲板上方 40 mm，接近几何中心） ================= -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.030 0.028 0.015"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="imu_blue">
        <color rgba="0.1 0.3 0.9 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="8.4e-7" ixy="0.0" ixz="0.0"
               iyy="9.4e-7" iyz="0.0"
               izz="1.4e-6"/>
    </inertial>
  </link>

  <!-- ================= camera_link：云台相机（初值占位，待 CAR-C05/C06 标定） ================= -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.040 0.030 0.030"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="camera_green">
        <color rgba="0.1 0.8 0.2 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="7.5e-6" ixy="0.0" ixz="0.0"
               iyy="1.0e-5" iyz="0.0"
               izz="1.0e-5"/>
    </inertial>
  </link>

  <!-- ================= ultrasonic：车头超声（初值占位） ================= -->
  <link name="ultrasonic">
    <visual>
      <geometry>
        <cylinder radius="0.010" length="0.030"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <material name="ultrasonic_orange">
        <color rgba="0.9 0.5 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0"
               iyy="1e-6" iyz="0.0"
               izz="5e-7"/>
    </inertial>
  </link>

  <!-- ============================ fixed joints（外参） ============================ -->

  <!-- base_footprint：相对 base_link 平移 0（base_link 即地面轴距中点） -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0.000 0.000 0.000" rpy="0 0 0"/>
  </joint>

  <!-- laser：J-04 —— 雷达在车头前 +0.107 m、上方 +0.034 m（待 CAR-C05 卷尺复核） -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.107 0.000 0.034" rpy="0 0 0"/>
  </joint>

  <!-- imu_link：设计 §5.5.5 —— 甲板上方约 40 mm（z=+0.08 初值，待卷尺复核） -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.000 0.000 0.080" rpy="0 0 0"/>
  </joint>

  <!-- camera_link：初值占位（pitch=0.0），待 CAR-C05/C06 标定后更新 -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.077 0.000 0.095" rpy="0 0 0"/>
  </joint>

  <!-- ultrasonic：车头超声，初值占位 -->
  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic"/>
    <origin xyz="0.070 0.000 0.030" rpy="0 0 0"/>
  </joint>

</robot>
