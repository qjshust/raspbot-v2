# RASPBOT-V2 sensor device names (installed at /etc/udev/rules.d/99-raspbot.rules)
#
# 雷达：思岚 RPLIDAR C1，板载 CP2102N USB 转串口（10c4:ea60），460800 8N1
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="raspbot_lidar", MODE="0666"

# ---------------------------------------------------------------------------
# IMU：维特智能 HWT101，115200 8N1。两条通道二选一，都叫 /dev/raspbot_imu，
# 所以 ros2 配置 (config/imu.yaml 的 serial_port) 不用跟着改。
#
#   A. USB-TTL（CH340，1a86:7523）—— 当前采用
#   B. 40-pin UART（GPIO14/15 → ttyAMA0）—— 备用
#
# 切换方法：
#   想走 B 就把 A 那行注释掉，并把 B 的 SYMLINK 改成 raspbot_imu；
#   两个通道千万别同时接同一个模块（两条主 UART + 3.3V 倒灌）。
#
# 走 B 时还要注意：cmdline.txt 里不能有 console=serial0 或 console=ttyAMA0，
# 否则内核控制台会占用该口。
# ---------------------------------------------------------------------------

# A. CH340 USB-TTL
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="raspbot_imu", MODE="0660", GROUP="dialout"

# B. 40-pin UART（备用，软链名故意不同）
SUBSYSTEM=="tty", KERNEL=="ttyAMA0", SYMLINK+="raspbot_imu_uart", MODE="0660", GROUP="dialout"
